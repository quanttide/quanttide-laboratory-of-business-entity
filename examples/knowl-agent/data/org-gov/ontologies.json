      "pattern": {
        "levels": ["顶层（基本章程/最高管理层）", "中间层（业务域章程/中层管理）", "基层（操作手册/执行层）"],
        "relation": "上层效力高于下层，下层不得与上层冲突"
      },
      "source_files": ["sample/basic-charter.md", "sample/secretary.md"]
    },
    {
