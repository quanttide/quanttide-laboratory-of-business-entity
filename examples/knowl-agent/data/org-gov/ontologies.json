      "pattern": {
        "stages": ["召集与通知", "出席与法定人数", "辩论与审议", "表决与决议", "记录与归档"],
        "rules": ["过半数出席", "三分之二多数通过", "提前通知"]
      },
      "source_files": ["sample/basic-charter.md", "sample/company-representative.md"]
    },
    {
      "id": "qualification-condition",
      "name": "资格-条件",
      "perspective": "组织管理",
      "description": "担任某职务或行使某权利所需的资格条件",
      "pattern": {
        "components": ["主体", "资格要求", "排除情形", "产生方式", "终止条件"],
        "examples": ["L2及以上职级具有代表资格", "L0成员不具有代表资格"]
